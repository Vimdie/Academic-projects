library(shiny)
library(shinyforms)
# Définition de la liste des questions du questionnaire EHCVM,
# en se basant sur la structure du script test que tu as fourni.
questions <- list(
list(
id = "sexe",
type = "select",
title = "Quel est ton sexe ?",
options = c("Homme", "Femme"),
mandatory = TRUE
),
list(
id = "age",
type = "numeric",
title = "Quel est ton âge ?",
mandatory = TRUE
),
list(
id = "niveau_instruction",
type = "select",
title = "Quel est le niveau d'instruction du chef du ménage ?",
options = c("Aucun", "Primaire", "Secondaire", "Supérieur"),
mandatory = TRUE
),
list(
id = "source_revenu",
type = "select",
title = "Quelle est la principale source de revenus du ménage ?",
options = c("Agriculture", "Commerce", "Salariat", "Aide familiale", "Autre"),
mandatory = TRUE
),
list(
id = "taille_menage",
type = "numeric",
title = "Combien de personnes vivent dans ce ménage ?",
mandatory = TRUE
)
)
# Définition de l'objet formInfo qui contient le formulaire complet
formInfo <- list(
id = "ehcvm",
questions = questions,
storage = list(
type = STORAGE_TYPES$FLATFILE,  # On utilise le stockage en flatfile (CSV)
path = "responses"              # Le dossier où les réponses seront enregistrées
)
)
# Interface utilisateur : on passe directement l'objet formInfo à formUI()
ui <- fluidPage(
titlePanel("Questionnaire EHCVM - shinyforms"),
formUI(formInfo)
)
