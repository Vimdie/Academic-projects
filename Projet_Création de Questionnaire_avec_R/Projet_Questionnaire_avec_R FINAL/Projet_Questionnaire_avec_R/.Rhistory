library(shiny)
library(shinyforms)
# Définition de la liste des questions sur une seule ligne chacune
questions <- list(
list(id = "sexe", type = "select", title = "Quel est ton sexe ?", options = c("Homme", "Femme"), mandatory = TRUE),
list(id = "age", type = "numeric", title = "Quel est ton âge ?", mandatory = TRUE),
list(id = "niveau_instruction", type = "select", title = "Quel est le niveau d'instruction du chef du ménage ?", options = c("Aucun", "Primaire", "Secondaire", "Supérieur"), mandatory = TRUE),
list(id = "source_revenu", type = "select", title = "Quelle est la principale source de revenus du ménage ?", options = c("Agriculture", "Commerce", "Salariat", "Aide familiale", "Autre"), mandatory = TRUE),
list(id = "taille_menage", type = "numeric", title = "Combien de personnes vivent dans ce ménage ?", mandatory = TRUE),
list(id = "moyenne_4e", type = "select", title = "Moyenne en sciences en classe de 4e", options = c("> 15/20", "[12/20;15/20]", "< 12/20"), mandatory = TRUE),
list(id = "moyenne_3e", type = "select", title = "Moyenne sciences 1er semestre 3e", options = c("< 10", "[10;12[", "[12;14[", "[14;16[", "[16;20]"), mandatory = TRUE),
list(id = "niveau_science", type = "select", title = "Comment juges-tu ton niveau en sciences ?", options = c("Excellent", "Bon", "Moyen", "Faible"), mandatory = TRUE),
list(id = "revision_science", type = "select", title = "Temps consacré aux révisions des sciences par semaine", options = c("Moins de 2h", "2 à 4h", "4 à 6h", "Plus de 6h"), mandatory = TRUE)
)
# Définition de l'objet formInfo qui regroupe le formulaire
formInfo <- list(
id = "ehcvm_form",
questions = questions,
storage = list(
type = STORAGE_TYPES$FLATFILE,  # Stockage local sous forme de flatfile (CSV)
path = "responses"              # Dossier où les réponses seront enregistrées
)
)
# Interface utilisateur : afficher le formulaire via formUI(formInfo)
ui <- fluidPage(
titlePanel("Questionnaire EHCVM - shinyforms"),
formUI(formInfo)
)
library(shiny)
library(shinyforms)
# Définition de la liste des questions sur une seule ligne chacune
questions <- list(
list(id = "sexe", type = "select", title = "Quel est ton sexe ?", options = c("Homme", "Femme"), mandatory = TRUE),
list(id = "age", type = "numeric", title = "Quel est ton âge ?", mandatory = TRUE),
list(id = "niveau_instruction", type = "select", title = "Quel est le niveau d'instruction du chef du ménage ?", options = c("Aucun", "Primaire", "Secondaire", "Supérieur"), mandatory = TRUE),
)
questions <- list(
list(id = "name", type = "text", title = "Name", mandatory = TRUE),
list(id = "age", type = "numeric", title = "Age"),
list(id = "favourite_pkg", type = "text", title = "Favourite R package"),
list(id = "terms", type = "checkbox", title = "I agree to the terms")
)
# Définition de l'objet formInfo qui regroupe le formulaire
formInfo <- list(
id = "ehcvm_form",
questions = questions,
storage = list(
type = STORAGE_TYPES$FLATFILE,  # Stockage local sous forme de flatfile (CSV)
path = "responses"              # Dossier où les réponses seront enregistrées
)
)
# Interface utilisateur : afficher le formulaire via formUI(formInfo)
ui <- fluidPage(
titlePanel("Questionnaire EHCVM - shinyforms"),
formUI(formInfo)
)
# Serveur : gestion des soumissions avec formServer(formInfo)
server <- function(input, output, session) {
formServer(formInfo)
}
# Lancer l'application
shinyApp(ui, server)
